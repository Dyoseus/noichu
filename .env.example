# Firebase Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git

# Firebase Web API Configuration (if needed for web platform)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# IMPORTANT NOTES:
# 1. For React Native, you need google-services.json (Android) and GoogleService-Info.plist (iOS)
# 2. These files should be downloaded from Firebase Console for each environment
# 3. DO NOT commit these files to git
# 4. Keep separate configs for development, staging, and production
